# AI Study Assistant V1.3.2（BYOK 多厂商模式）

# 用户在网页“⚙ API 设置”里选择厂商并填自己的密钥：
# 支持 DeepSeek / Kimi / 通义千问 / 硅基流动 / 智谱 GLM / OpenRouter。
# 服务器端密钥配置不再被使用（可从 backend/.env 与 Render 环境变量中删除）。
# DEEPSEEK_API_KEY=your_api_key_here

# AI 接口限流（chat/quiz/diagnose/study-plan，按 IP 计数）
# 格式：<次数>/<时间单位>，例如 10/minute、5/minute
AI_RATE_LIMIT=10/minute

# 上传接口限流
UPLOAD_RATE_LIMIT=20/minute

# API 文档开关：本地开发保持 1；部署到公网建议设为 0
ENABLE_DOCS=1
